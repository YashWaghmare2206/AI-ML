import numpy as np

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

# Input
x = np.array([200, 17])


# Layer 1 → 3 neurons

# Neuron 1
w1_1 = np.array([1, 2])
b1_1 = np.array([-1])

z1_1 = np.dot(w1_1, x) + b1_1
a1_1 = sigmoid(z1_1)


# Neuron 2
w1_2 = np.array([2, 1])
b1_2 = np.array([-2])

z1_2 = np.dot(w1_2, x) + b1_2
a1_2 = sigmoid(z1_2)


# Neuron 3
w1_3 = np.array([1, -1])
b1_3 = np.array([3])

z1_3 = np.dot(w1_3, x) + b1_3
a1_3 = sigmoid(z1_3)


# Output of Layer 1
a1 = np.array([a1_1, a1_2, a1_3])


# Layer 2 → 2 neurons

# Neuron 1
w2_1 = np.array([1, 2, 3])
b2_1 = np.array([-1])

z2_1 = np.dot(w2_1, a1) + b2_1
a2_1 = sigmoid(z2_1)


# Neuron 2
w2_2 = np.array([2, -1, 1])
b2_2 = np.array([2])

z2_2 = np.dot(w2_2, a1) + b2_2
a2_2 = sigmoid(z2_2)


# Output of Layer 2
a2 = np.array([a2_1, a2_2])

print("Layer 1 output:", a1)
print("Layer 2 output:", a2)
