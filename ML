def draw(event):

    x = event.x
    y = event.y

    # Draw white line on black background
    canvas.create_oval(
        x - 10,
        y - 10,
        x + 10,
        y + 10,
        fill="white",
        outline="white"
    )


canvas.bind("<B1-Motion>", draw)


